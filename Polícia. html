    if(indice>=perguntasAtuais.length){
        finalizarTeste();
        return;
    }

    const q=perguntasAtuais[indice];

    document.getElementById("numero").innerText=
        "Questão "+(indice+1)+" / "+perguntasAtuais.length;

    document.getElementById("pontuacao").innerText=
        "Pontos: "+pontos;

    document.getElementById("barra").style.width=
        ((indice/perguntasAtuais.length)*100)+"%";

    document.getElementById("questao").innerHTML=
        `<div class="question">${q.pergunta}</div>`;

    const opcoes=document.getElementById("opcoes");

    opcoes.innerHTML="";

    q.opcoes.forEach((opcao,i)=>{

        const botao=document.createElement("button");

        botao.className="option";

        botao.innerText=
            String.fromCharCode(65+i)+") "+opcao;

        botao.onclick=()=>responder(i);

        opcoes.appendChild(botao);

    });

}


/* =========================
   RESPONDER
========================= */

function responder(escolha){

    const q=perguntasAtuais[indice];

    respostas.push({
        pergunta:q,
        escolha:escolha
    });

    if(escolha===q.resposta){

        pontos++;

    }

    indice++;

    mostrarQuestao();

}


/* =========================
   CRONÓMETRO
========================= */

function iniciarCronometro(){

    clearInterval(intervalo);

    intervalo=setInterval(()=>{

        tempoRestante--;

        atualizarTempo();

        if(tempoRestante<=0){

            clearInterval(intervalo);

            finalizarTeste();

        }

    },1000);

    atualizarTempo();

}


function atualizarTempo(){

    const minutos=
        Math.floor(tempoRestante/60);

    const segundos=
        tempoRestante%60;

    document.getElementById("tempo").innerText=
        String(minutos).padStart(2,"0")+
        ":"+
        String(segundos).padStart(2,"0");

}


/* =========================
   FINALIZAR
========================= */

function finalizarTeste(){

    clearInterval(intervalo);

    document.getElementById("teste").classList.add("hidden");

    document.getElementById("resultado").classList.remove("hidden");

    const total=perguntasAtuais.length;

    const percent=
        Math.round((pontos/total)*100);

    let mensagem="";

    if(percent>=90){

        mensagem="🏆 EXCELENTE — nível muito elevado.";

    }else if(percent>=75){

        mensagem="🔥 MUITO BOM — continue a treinar velocidade.";

    }else if(percent>=60){

        mensagem="⚠️ BOM — mas ainda há espaço para melhorar.";

    }else{

        mensagem="🚨 PRECISA DE TREINO — aumente a prática.";

    }

    const xp=pontos*10;

    document.getElementById("resultadoTexto").innerHTML=`

        <p><b>${pontos}/${total}</b></p>

        <p><b>${percent}% de aproveitamento</b></p>

        <p>${mensagem}</p>

        <p>⭐ XP conquistado: <b>${xp}</b></p>

    `;

    calcularEstatisticas();

}


/* =========================
   ESTATÍSTICAS
========================= */

function calcularEstatisticas(){

    const categorias={};

    perguntasAtuais.forEach((q,i)=>{

        if(!categorias[q.categoria]){

            categorias[q.categoria]={
                total:0,
                certas:0
            };

        }

        categorias[q.categoria].total++;

        if(
            respostas[i] &&
            respostas[i].escolha===q.resposta
        ){

            categorias[q.categoria].certas++;

        }

    });


    let html="<h3>📊 Desempenho por competência</h3>";

    for(const cat in categorias){

        const dados=categorias[cat];

        const percent=
            Math.round(
                (dados.certas/dados.total)*100
            );

        html+=`

        <div class="stat">

        <b>${nomeCategoria(cat)}</b><br>

        ${dados.certas}/${dados.total}
        — ${percent}%

        </div>

        `;

    }

    html+=`

    <h3>📝 Revisão</h3>

    <p>
    A revisão das respostas deve ser usada para identificar
    os tipos de erro e melhorar a velocidade.
    </p>

    `;

    document.getElementById("estatisticas").innerHTML=html;

}


function nomeCategoria(cat){

    const nomes={

        logica:"🧠 Raciocínio lógico",

        numerico:"🔢 Raciocínio numérico",

        verbal:"🔤 Raciocínio verbal",

        atencao:"👁️ Atenção",

        abstrato:"🧩 Padrões e abstrato"

    };

    return nomes[cat] || cat;

}

