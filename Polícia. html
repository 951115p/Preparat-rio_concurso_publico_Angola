/* =========================
   INICIAR
========================= */

function iniciarTeste(){

    const categoria=document.getElementById("categoria").value;

    perguntasAtuais=banco.filter(q=>
        categoria==="todas" || q.categoria===categoria
    );

    perguntasAtuais=embaralhar(perguntasAtuais);

    // Máximo de 50
    perguntasAtuais=perguntasAtuais.slice(0,50);

    if(perguntasAtuais.length===0){
        alert("Não existem questões nesta categoria.");
        return;
    }

    indice=0;
    pontos=0;
    respostas=[];

    tempoRestante=1500;

    document.getElementById("config").classList.add("hidden");
    document.getElementById("teste").classList.remove("hidden");

    iniciarCronometro();
    mostrarQuestao();
}


/* =========================
   EMBARALHAR
========================= */

function embaralhar(array){

    return array.sort(()=>Math.random()-0.5);

}


